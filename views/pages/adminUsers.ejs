<div class="page-header">
  <div>
    <div class="page-title">User Management</div>
    <div class="page-subtitle">View, activate/deactivate, and manage user roles</div>
  </div>
  <span class="badge badge-danger"><i class="fas fa-shield-alt"></i> Admin</span>
</div>

<!-- Filters -->
<div class="card mb-6">
  <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
    <div class="input-group" style="flex:1;min-width:200px">
      <i class="fas fa-search input-icon"></i>
      <input class="form-control" id="userSearch" placeholder="Search name or email…" oninput="debounce(loadUsers,400)()">
    </div>
    <select class="form-control" id="roleFilter" style="width:140px" onchange="loadUsers()">
      <option value="">All Roles</option>
      <option value="user">User</option>
      <option value="admin">Admin</option>
    </select>
    <button class="btn btn-primary btn-sm" onclick="loadUsers()">
      <i class="fas fa-sync-alt"></i> Refresh
    </button>
  </div>
</div>

<!-- Users table -->
<div class="card">
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>User</th><th>Role</th><th>Joined</th><th>Last Login</th><th>Logins</th><th>Status</th><th>Actions</th>
        </tr>
      </thead>
      <tbody id="usersTableBody">
        <tr><td colspan="7" style="text-align:center;padding:32px">
          <div class="loading-spinner dark" style="margin:0 auto 12px"></div>Loading users…
        </td></tr>
      </tbody>
    </table>
  </div>
  <div id="usersPagination" style="display:flex;justify-content:center;gap:8px;padding:16px"></div>
</div>

<!-- Role change modal -->
<div id="roleModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;display:none;align-items:center;justify-content:center">
  <div class="card" style="width:100%;max-width:400px;margin:20px">
    <div class="card-header">
      <div class="card-title"><i class="fas fa-user-cog"></i> Change Role</div>
      <button class="btn-ghost btn-icon" onclick="closeRoleModal()"><i class="fas fa-times"></i></button>
    </div>
    <p style="font-size:14px;color:var(--text-muted);margin-bottom:16px">
      Changing role for: <strong id="roleModalUser"></strong>
    </p>
    <select class="form-control mb-4" id="newRoleSelect">
      <option value="user">User</option>
      <option value="admin">Admin</option>
    </select>
    <div class="d-flex gap-2">
      <button class="btn btn-primary" onclick="confirmRoleChange()">Save</button>
      <button class="btn btn-outline" onclick="closeRoleModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
let currentPage = 1;
let roleChangeId = null;

const debounce = (fn, ms) => { let t; return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); }; };

async function loadUsers(page = 1) {
  currentPage = page;
  const search = document.getElementById('userSearch').value;
  const role   = document.getElementById('roleFilter').value;
  const tbody  = document.getElementById('usersTableBody');

  tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:24px"><div class="loading-spinner dark" style="margin:0 auto 10px"></div>Loading…</td></tr>';

  try {
    const params = new URLSearchParams({ page, limit:15, search, role }).toString();
    const data = await api.get(`/api/admin/users?${params}`);

    tbody.innerHTML = data.users.map(u => `
      <tr>
        <td>
          <div class="d-flex align-center gap-2">
            <div class="user-avatar" style="width:34px;height:34px;font-size:13px;flex-shrink:0">${u.name.charAt(0)}</div>
            <div>
              <div style="font-weight:600;font-size:13px">${u.name}</div>
              <div style="font-size:11px;color:var(--text-muted)">${u.email}</div>
            </div>
          </div>
        </td>
        <td><span class="badge badge-${u.role==='admin'?'danger':'primary'}">${u.role}</span></td>
        <td style="font-size:12px;color:var(--text-muted)">${new Date(u.createdAt).toLocaleDateString()}</td>
        <td style="font-size:12px;color:var(--text-muted)">${u.lastLogin ? new Date(u.lastLogin).toLocaleDateString() : '—'}</td>
        <td style="font-size:13px;font-weight:600">${u.loginCount||0}</td>
        <td>
          <span class="badge badge-${u.isActive?'success':'danger'}">
            <i class="fas fa-circle" style="font-size:7px"></i>
            ${u.isActive?'Active':'Inactive'}
          </span>
        </td>
        <td>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline" onclick="toggleUser('${u._id}', this)" title="${u.isActive?'Deactivate':'Activate'}">
              <i class="fas fa-toggle-${u.isActive?'on':'off'}"></i>
            </button>
            <button class="btn btn-sm btn-outline" onclick="openRoleModal('${u._id}','${u.name}','${u.role}')" title="Change role">
              <i class="fas fa-user-cog"></i>
            </button>
            <button class="btn btn-sm btn-danger" onclick="deleteUser('${u._id}','${u.name}')" title="Delete user">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>`).join('') || '<tr><td colspan="7" style="text-align:center;padding:24px;color:var(--text-muted)">No users found</td></tr>';

    // Pagination
    const pg = document.getElementById('usersPagination');
    pg.innerHTML = Array.from({length: data.pages}, (_,i) => `
      <button class="btn btn-sm ${i+1===currentPage?'btn-primary':'btn-outline'}" onclick="loadUsers(${i+1})">${i+1}</button>
    `).join('');
  } catch(e) { showToast(e.message, 'error'); }
}

async function toggleUser(id, btn) {
  try {
    const data = await api.put(`/api/admin/users/${id}/toggle`, {});
    showToast(data.message, 'success');
    loadUsers(currentPage);
  } catch(e) { showToast(e.message, 'error'); }
}

function openRoleModal(id, name, role) {
  roleChangeId = id;
  document.getElementById('roleModalUser').textContent = name;
  document.getElementById('newRoleSelect').value = role;
  document.getElementById('roleModal').style.display = 'flex';
}
function closeRoleModal() { document.getElementById('roleModal').style.display = 'none'; roleChangeId = null; }

async function confirmRoleChange() {
  if (!roleChangeId) return;
  try {
    const role = document.getElementById('newRoleSelect').value;
    await api.put(`/api/admin/users/${roleChangeId}/role`, { role });
    showToast('Role updated', 'success');
    closeRoleModal();
    loadUsers(currentPage);
  } catch(e) { showToast(e.message, 'error'); }
}

async function deleteUser(id, name) {
  if (!confirm(`Delete user "${name}" and all their data? This cannot be undone.`)) return;
  try {
    await api.delete(`/api/admin/users/${id}`);
    showToast('User deleted', 'success');
    loadUsers(currentPage);
  } catch(e) { showToast(e.message, 'error'); }
}

document.addEventListener('DOMContentLoaded', () => loadUsers());
</script>
