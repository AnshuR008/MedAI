<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;text-align:center;padding:40px">
  <div style="font-size:80px;font-weight:900;color:var(--gray-200);line-height:1"><%= statusCode || 500 %></div>
  <div style="font-size:24px;font-weight:700;color:var(--text-primary);margin:16px 0 8px"><%= statusCode === 404 ? 'Page Not Found' : 'Something Went Wrong' %></div>
  <div style="font-size:15px;color:var(--text-muted);max-width:400px;margin-bottom:32px">
    <%= message || 'An unexpected error occurred. Please try again.' %>
  </div>
  <div style="display:flex;gap:12px">
    <button onclick="history.back()" class="btn btn-outline">
      <i class="fas fa-arrow-left"></i> Go Back
    </button>
    <a href="/dashboard" class="btn btn-primary">
      <i class="fas fa-home"></i> Dashboard
    </a>
  </div>
</div>
