<div class="page-header">
  <div>
    <div class="page-title">Admin Dashboard</div>
    <div class="page-subtitle">System overview and management console</div>
  </div>
  <span class="badge badge-danger" style="font-size:12px;padding:6px 14px"><i class="fas fa-shield-alt"></i> Administrator</span>
</div>

<div class="stats-grid mb-6">
  <div class="stat-card blue"><div class="stat-icon blue"><i class="fas fa-users"></i></div>
    <div class="stat-value" id="totalUsers">—</div><div class="stat-label">Total Users</div></div>
  <div class="stat-card green"><div class="stat-icon green"><i class="fas fa-stethoscope"></i></div>
    <div class="stat-value" id="totalPredictions">—</div><div class="stat-label">Total Predictions</div></div>
  <div class="stat-card orange"><div class="stat-icon orange"><i class="fas fa-comment-medical"></i></div>
    <div class="stat-value" id="totalChats">—</div><div class="stat-label">Chat Sessions</div></div>
  <div class="stat-card purple"><div class="stat-icon purple"><i class="fas fa-user-check"></i></div>
    <div class="stat-value" id="activeToday">—</div><div class="stat-label">Active Today</div></div>
</div>

<!-- Quick nav cards -->
<div class="grid-2 mb-6">
  <a href="/admin/users" class="card" style="cursor:pointer;text-decoration:none;transition:all 0.2s">
    <div class="d-flex align-center gap-4">
      <div style="width:52px;height:52px;background:rgba(0,180,216,0.12);border-radius:12px;display:flex;align-items:center;justify-content:center;color:var(--teal);font-size:22px;flex-shrink:0">
        <i class="fas fa-users-cog"></i></div>
      <div><div style="font-size:16px;font-weight:700">User Management</div>
        <div style="font-size:13px;color:var(--text-muted)">View, activate and manage roles</div></div>
      <i class="fas fa-chevron-right" style="margin-left:auto;color:var(--text-muted)"></i>
    </div>
  </a>
  <a href="/admin/diseases" class="card" style="cursor:pointer;text-decoration:none">
    <div class="d-flex align-center gap-4">
      <div style="width:52px;height:52px;background:rgba(6,214,160,0.12);border-radius:12px;display:flex;align-items:center;justify-content:center;color:var(--green);font-size:22px;flex-shrink:0">
        <i class="fas fa-database"></i></div>
      <div><div style="font-size:16px;font-weight:700">Disease Database</div>
        <div style="font-size:13px;color:var(--text-muted)">Add, edit, delete medical entries</div></div>
      <i class="fas fa-chevron-right" style="margin-left:auto;color:var(--text-muted)"></i>
    </div>
  </a>
  <a href="/admin/analytics" class="card" style="cursor:pointer;text-decoration:none">
    <div class="d-flex align-center gap-4">
      <div style="width:52px;height:52px;background:rgba(139,92,246,0.12);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#8b5cf6;font-size:22px;flex-shrink:0">
        <i class="fas fa-chart-bar"></i></div>
      <div><div style="font-size:16px;font-weight:700">Analytics</div>
        <div style="font-size:13px;color:var(--text-muted)">Trends, charts and platform metrics</div></div>
      <i class="fas fa-chevron-right" style="margin-left:auto;color:var(--text-muted)"></i>
    </div>
  </a>
  <a href="/admin/logs" class="card" style="cursor:pointer;text-decoration:none">
    <div class="d-flex align-center gap-4">
      <div style="width:52px;height:52px;background:rgba(245,158,11,0.12);border-radius:12px;display:flex;align-items:center;justify-content:center;color:var(--warning);font-size:22px;flex-shrink:0">
        <i class="fas fa-terminal"></i></div>
      <div><div style="font-size:16px;font-weight:700">System Logs</div>
        <div style="font-size:13px;color:var(--text-muted)">Prediction, chat and server logs</div></div>
      <i class="fas fa-chevron-right" style="margin-left:auto;color:var(--text-muted)"></i>
    </div>
  </a>
</div>

<!-- Recent users -->
<div class="card">
  <div class="card-header">
    <div class="card-title"><i class="fas fa-users"></i> Recent Users</div>
    <a href="/admin/users" class="btn btn-ghost btn-sm">View All</a>
  </div>
  <div class="table-wrapper">
    <table>
      <thead><tr><th>User</th><th>Role</th><th>Joined</th><th>Logins</th><th>Status</th></tr></thead>
      <tbody id="recentUsersTable">
        <tr><td colspan="5" style="text-align:center;padding:24px"><div class="loading-spinner dark" style="margin:0 auto"></div></td></tr>
      </tbody>
    </table>
  </div>
</div>

<script>
async function loadAdminSummary() {
  try {
    const { data } = await api.get('/api/admin/analytics/summary');
    animateCount(document.getElementById('totalUsers'),       data.users.total);
    animateCount(document.getElementById('totalPredictions'), data.predictions.total);
    animateCount(document.getElementById('totalChats'),       data.chats);
    animateCount(document.getElementById('activeToday'),      data.users.activeToday);
  } catch(e) { showToast('Failed to load stats', 'error'); }
}

async function loadRecentUsers() {
  try {
    const data = await api.get('/api/admin/users?limit=8&page=1');
    const tbody = document.getElementById('recentUsersTable');
    tbody.innerHTML = data.users.map(u => `
      <tr>
        <td><div class="d-flex align-center gap-2">
          <div class="user-avatar" style="width:32px;height:32px;font-size:12px">${u.name.charAt(0)}</div>
          <div><div style="font-size:13px;font-weight:600">${u.name}</div>
            <div style="font-size:11px;color:var(--text-muted)">${u.email}</div></div>
        </div></td>
        <td><span class="badge badge-${u.role==='admin'?'danger':'primary'}">${u.role}</span></td>
        <td style="font-size:12px;color:var(--text-muted)">${new Date(u.createdAt).toLocaleDateString()}</td>
        <td style="font-size:13px;font-weight:600">${u.loginCount||0}</td>
        <td><span class="badge badge-${u.isActive?'success':'danger'}">${u.isActive?'Active':'Inactive'}</span></td>
      </tr>`).join('');
  } catch(e) {}
}

document.addEventListener('DOMContentLoaded', () => { loadAdminSummary(); loadRecentUsers(); });
</script>
