<div class="page-header">
  <div>
    <div class="page-title">Medication Reminders</div>
    <div class="page-subtitle">Track your medications, dosages, and schedules</div>
  </div>
  <button class="btn btn-primary" id="addMedBtn">
    <i class="fas fa-plus"></i> Add Medication
  </button>
</div>

<!-- Add Medication Modal -->
<div id="medModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center">
  <div style="background:var(--surface);border-radius:16px;padding:28px;width:100%;max-width:480px;margin:20px;border:1px solid var(--border)">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px">
      <h3 style="font-size:18px;font-weight:700;color:white;margin:0">Add Medication</h3>
      <button id="closeModal" style="background:none;border:none;color:var(--text-muted);font-size:20px;cursor:pointer"><i class="fas fa-times"></i></button>
    </div>
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="form-group" style="margin:0">
        <label class="form-label">Medication Name *</label>
        <input type="text" class="form-control" id="medName" placeholder="e.g. Metformin 500mg">
      </div>
      <div class="form-group" style="margin:0">
        <label class="form-label">Dosage</label>
        <input type="text" class="form-control" id="medDosage" placeholder="e.g. 1 tablet">
      </div>
      <div class="form-group" style="margin:0">
        <label class="form-label">Frequency</label>
        <select class="form-control" id="medFrequency">
          <option value="once_daily">Once daily</option>
          <option value="twice_daily">Twice daily</option>
          <option value="three_times">Three times daily</option>
          <option value="four_times">Four times daily</option>
          <option value="weekly">Weekly</option>
          <option value="as_needed">As needed</option>
        </select>
      </div>
      <div class="form-group" style="margin:0">
        <label class="form-label">Time(s)</label>
        <input type="text" class="form-control" id="medTimes" placeholder="e.g. 08:00, 20:00">
        <small style="color:var(--text-muted);font-size:11px">Comma-separated times in HH:MM format</small>
      </div>
      <div class="form-group" style="margin:0">
        <label class="form-label">Notes</label>
        <input type="text" class="form-control" id="medNotes" placeholder="e.g. Take with food">
      </div>
      <div class="form-group" style="margin:0">
        <label class="form-label">Colour</label>
        <div style="display:flex;gap:10px;flex-wrap:wrap" id="colorPicker">
          <% ['#00b4d8','#06d6a0','#ffd166','#ef476f','#a78bfa','#fb923c'].forEach(c => { %>
          <div class="color-dot" data-color="<%= c %>" style="width:28px;height:28px;border-radius:50%;background:<%= c %>;cursor:pointer;border:2px solid transparent"></div>
          <% }) %>
        </div>
      </div>
      <button class="btn btn-primary" id="saveMedBtn" style="margin-top:8px">
        <i class="fas fa-save"></i> Save Medication
      </button>
    </div>
  </div>
</div>

<!-- Medications List -->
<% if (medications && medications.length > 0) { %>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
  <% medications.forEach(med => { %>
  <div class="card" style="border-left:4px solid <%= med.color || '#00b4d8' %>;padding:20px">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px">
      <div>
        <div style="font-size:16px;font-weight:700;color:white"><%= med.medicationName %></div>
        <% if (med.dosage) { %><div style="font-size:13px;color:var(--text-muted);margin-top:2px"><%= med.dosage %></div><% } %>
      </div>
      <button class="btn btn-ghost btn-sm delete-med" data-id="<%= med._id %>" style="color:#ef476f;padding:4px 8px">
        <i class="fas fa-trash"></i>
      </button>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px">
      <div style="display:flex;align-items:center;gap:8px">
        <i class="fas fa-sync-alt" style="width:14px;color:var(--teal);font-size:12px"></i>
        <span style="font-size:13px;color:var(--text-muted);text-transform:capitalize"><%= med.frequency.replace(/_/g,' ') %></span>
      </div>
      <% if (med.times && med.times.length > 0) { %>
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <i class="fas fa-clock" style="width:14px;color:var(--teal);font-size:12px"></i>
        <% med.times.forEach(t => { %>
        <span style="font-size:12px;background:rgba(0,180,216,0.15);color:var(--teal);padding:2px 10px;border-radius:100px"><%= t %></span>
        <% }) %>
      </div>
      <% } %>
      <% if (med.notes) { %>
      <div style="display:flex;align-items:flex-start;gap:8px">
        <i class="fas fa-sticky-note" style="width:14px;color:var(--text-muted);font-size:12px;margin-top:2px"></i>
        <span style="font-size:12px;color:var(--text-muted)"><%= med.notes %></span>
      </div>
      <% } %>
    </div>
    <div style="font-size:11px;color:var(--text-muted);margin-top:12px;border-top:1px solid var(--border);padding-top:10px">
      Added <%= new Date(med.createdAt).toLocaleDateString() %>
    </div>
  </div>
  <% }) %>
</div>
<% } else { %>
<div class="card">
  <div class="empty-state" style="padding:60px 24px">
    <div class="empty-icon"><i class="fas fa-pills"></i></div>
    <h3>No Medications Tracked</h3>
    <p>Keep track of your medications, doses, and schedule all in one place</p>
    <button class="btn btn-primary mt-4" id="addMedBtn2"><i class="fas fa-plus"></i> Add First Medication</button>
  </div>
</div>
<% } %>

<script>
const modal = document.getElementById('medModal');
let selectedColor = '#00b4d8';

function openModal() { modal.style.display = 'flex'; }
document.getElementById('addMedBtn')?.addEventListener('click', openModal);
document.getElementById('addMedBtn2')?.addEventListener('click', openModal);
document.getElementById('closeModal').addEventListener('click', () => { modal.style.display = 'none'; });

// Color picker
document.querySelectorAll('.color-dot').forEach(dot => {
  dot.addEventListener('click', () => {
    document.querySelectorAll('.color-dot').forEach(d => d.style.border = '2px solid transparent');
    dot.style.border = '2px solid white';
    selectedColor = dot.dataset.color;
  });
});
// Select first color by default
document.querySelector('.color-dot')?.click();

document.getElementById('saveMedBtn').addEventListener('click', async () => {
  const name = document.getElementById('medName').value.trim();
  if (!name) { alert('Please enter a medication name'); return; }
  const times = document.getElementById('medTimes').value.split(',').map(t => t.trim()).filter(Boolean);
  const btn = document.getElementById('saveMedBtn');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
  try {
    const res = await fetch('/api/medications', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        medicationName: name,
        dosage: document.getElementById('medDosage').value.trim(),
        frequency: document.getElementById('medFrequency').value,
        times,
        notes: document.getElementById('medNotes').value.trim(),
        color: selectedColor
      })
    });
    const data = await res.json();
    if (data.success) { window.location.reload(); }
    else { alert(data.message || 'Failed to save'); btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Save Medication'; }
  } catch(e) { alert('Error saving medication'); btn.disabled = false; btn.innerHTML = '<i class="fas fa-save"></i> Save Medication'; }
});

document.querySelectorAll('.delete-med').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('Remove this medication?')) return;
    const id = btn.dataset.id;
    const res = await fetch(`/api/medications/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) window.location.reload();
  });
});

// Close on backdrop click
modal.addEventListener('click', e => { if (e.target === modal) modal.style.display = 'none'; });
</script>
