<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <div class="brand">
      <div class="brand-icon"><i class="fas fa-heartbeat"></i></div>
      <div class="brand-text">
        <span class="brand-name">MedAI</span>
        <span class="brand-sub">Health Platform</span>
      </div>
    </div>
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
      <i class="fas fa-bars"></i>
    </button>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <span class="nav-label">Main</span>
      <a href="/dashboard"  class="nav-item <%- locals.title?.includes('Dashboard') && !locals.title?.includes('Admin') ? 'active' : '' %>">
        <i class="fas fa-th-large"></i><span>Dashboard</span>
      </a>
      <a href="/predict"    class="nav-item <%- locals.title?.includes('Symptom') ? 'active' : '' %>">
        <i class="fas fa-stethoscope"></i><span>Symptom Checker</span>
      </a>
      <a href="/chat"       class="nav-item <%- locals.title?.includes('Chat') ? 'active' : '' %>">
        <i class="fas fa-comment-medical"></i><span>AI Assistant</span>
      </a>
      <a href="/diseases"   class="nav-item <%- locals.title?.includes('Disease') && !locals.title?.includes('Admin') ? 'active' : '' %>">
        <i class="fas fa-search"></i><span>Disease Search</span>
      </a>
    </div>

    <div class="nav-section">
      <span class="nav-label">Insights</span>
      <a href="/history"    class="nav-item <%- locals.title?.includes('History') ? 'active' : '' %>">
        <i class="fas fa-history"></i><span>History</span>
      </a>
      <a href="/medications" class="nav-item <%- locals.title?.includes('Medication') ? 'active' : '' %>">
        <i class="fas fa-pills"></i><span>Medications</span>
      </a>
      <a href="/analytics"  class="nav-item <%- locals.title?.includes('Analytics') && !locals.title?.includes('Admin') ? 'active' : '' %>">
        <i class="fas fa-chart-line"></i><span>Analytics</span>
      </a>
    </div>

    <div class="nav-section">
      <span class="nav-label">Account</span>
      <a href="/profile"    class="nav-item <%- locals.title?.includes('Profile') ? 'active' : '' %>">
        <i class="fas fa-user-circle"></i><span>Profile</span>
      </a>
    </div>

    <% if (user && user.role === 'admin') { %>
    <div class="nav-section">
      <span class="nav-label">Admin</span>
      <a href="/admin"           class="nav-item <%- locals.title === 'Admin Dashboard - MedAI' ? 'active' : '' %>">
        <i class="fas fa-tachometer-alt"></i><span>Overview</span>
      </a>
      <a href="/admin/users"     class="nav-item <%- locals.title?.includes('User Management') ? 'active' : '' %>">
        <i class="fas fa-users-cog"></i><span>Users</span>
      </a>
      <a href="/admin/diseases"  class="nav-item <%- locals.title?.includes('Disease Management') ? 'active' : '' %>">
        <i class="fas fa-database"></i><span>Diseases</span>
      </a>
      <a href="/admin/analytics" class="nav-item <%- locals.title?.includes('Admin Analytics') ? 'active' : '' %>">
        <i class="fas fa-chart-bar"></i><span>Analytics</span>
      </a>
      <a href="/admin/logs"      class="nav-item <%- locals.title?.includes('System Logs') ? 'active' : '' %>">
        <i class="fas fa-terminal"></i><span>System Logs</span>
      </a>
    </div>
    <% } %>

    <div class="nav-section">
      <a href="/logout" class="nav-item nav-logout">
        <i class="fas fa-sign-out-alt"></i><span>Logout</span>
      </a>
    </div>
  </nav>

  <div class="sidebar-user">
    <div class="user-avatar"><%= user ? user.name.charAt(0).toUpperCase() : 'U' %></div>
    <div class="user-info">
      <span class="user-name"><%= user ? user.name : 'User' %></span>
      <span class="user-role"><%= user ? user.role : 'user' %></span>
    </div>
  </div>
</aside>
