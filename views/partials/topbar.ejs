<header class="topbar">
  <div class="topbar-left">
    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
      <i class="fas fa-bars"></i>
    </button>
    <div class="page-breadcrumb">
      <span><%= locals.title ? locals.title.split(' - ')[0] : 'Dashboard' %></span>
    </div>
  </div>
  <div class="topbar-right">
    <div class="topbar-date">
      <i class="fas fa-calendar-alt"></i>
      <span id="currentDate"></span>
    </div>
    <div class="topbar-notification" title="Notifications">
      <i class="fas fa-bell"></i>
      <span class="notif-dot"></span>
    </div>
    <div class="topbar-user">
      <div class="topbar-avatar"><%= user ? user.name.charAt(0).toUpperCase() : 'U' %></div>
      <span><%= user ? user.name.split(' ')[0] : 'User' %></span>
      <% if (user && user.role === 'admin') { %>
        <span class="badge badge-danger" style="margin-left:4px;font-size:9px">ADMIN</span>
      <% } %>
    </div>
  </div>
</header>
